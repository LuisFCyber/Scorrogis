# ============================================================================
# Variáveis de Ambiente - Plataforma Rotas Seguras
# Copie este arquivo para .env (desenvolvimento) ou configure na Vercel
# ============================================================================

# --- Banco de dados (desenvolvimento local) ---
# Para protótipo SQLite local (não usar em produção)
DATABASE_URL="file:./dev.db"

# --- Supabase (PRODUÇÃO - obrigatório para deploy na Vercel) ---
# Pegar em: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key-aqui"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key-aqui"  # server-only - NUNCA expor no cliente

# URL do banco Postgres do Supabase (para Prisma em produção)
# Pegar em: Supabase Dashboard → Settings → Database → Connection string → URI
# Formato: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL_PROD="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# --- WebSocket / Real-time ---
# Porta do mini-service Socket.io (apenas local - na Vercel usaremos Supabase Realtime)
REALTIME_PORT=3003

# --- App ---
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Mapa (opcional - apenas se quiser tiles próprios) ---
# Por padrão usamos OpenStreetMap (gratuito, sem chave)
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

# --- Sentry / Monitoramento (opcional, recomendado para produção) ---
SENTRY_DSN=""

# ============================================================================
# INSTRUÇÕES:
#
# 1. LOCAL (desenvolvimento):
#    - Deixe apenas DATABASE_URL ativo
#    - As variáveis NEXT_PUBLIC_* não são necessárias em dev
#
# 2. VERCEL (produção):
#    - Configure TODAS as variáveis no painel da Vercel
#    - DATABASE_URL deve apontar para o Postgres do Supabase
#    - NEXT_PUBLIC_SUPABASE_URL e NEXT_PUBLIC_SUPABASE_ANON_KEY são expostas ao browser
#    - SUPABASE_SERVICE_ROLE_KEY fica apenas no servidor (server-only)
#
# 3. SEGURANÇA:
#    - NUNCA commite o arquivo .env real
#    - Gere novas chaves se vazarem
#    - Rode o SQL de RLS (Row Level Security) no Supabase para proteção extra
# ============================================================================
