// Prisma schema - protótipo local (SQLite) da Plataforma Rotas Seguras
// Para produção, use o schema PostGIS em download/001_postgis_schema.sql

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model IncidentReport {
  id          String   @id @default(cuid())
  type        String   // 'flood' | 'landslide' | 'safe_passage' | 'roadblock'
  severity    String   @default("medium") // 'low' | 'medium' | 'high' | 'critical'
  longitude   Float
  latitude    Float
  description String?
  upvotes     Int      @default(0)
  downvotes   Int      @default(0)
  verified    Boolean  @default(false)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([verified])
  @@index([expiresAt])
}

model Shelter {
  id             String   @id @default(cuid())
  name           String
  type           String   @default("shelter") // 'shelter' | 'hospital' | 'food_distribution' | 'checkpoint'
  longitude      Float
  latitude       Float
  capacityTotal  Int      @default(0)
  capacityUsed   Int      @default(0)
  capacityStatus String   @default("unknown") // 'available' | 'limited' | 'full' | 'unknown'
  contactInfo    String?  // JSON string
  suppliesNeeded String?  // JSON array string
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type])
  @@index([isActive])
}

model SurvivorSignal {
  id            String   @id @default(cuid())
  peopleCount   Int      @default(1)
  urgencyLevel  String   @default("safe_waiting") // 'safe_waiting' | 'need_medical' | 'need_evacuation' | 'critical'
  longitude     Float
  latitude      Float
  isResolved    Boolean  @default(false)
  contactInfo   String?  // PII - mantido apenas no cliente, nunca em texto puro
  anonymize     Boolean  @default(true)
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isResolved])
  @@index([urgencyLevel])
}

model RouteValidation {
  id          String   @id @default(cuid())
  incidentId  String
  vote        Boolean  // true = confirmado, false = resolvido
  comment     String?
  createdAt   DateTime @default(now())

  @@index([incidentId])
}
